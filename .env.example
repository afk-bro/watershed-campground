# Environment Configuration Example
# Copy this file to .env.local (dev) or .env.test (tests) and fill in actual values
# DO NOT commit real credentials to version control!

# ============================================================================
# REQUIRED - Core Application
# ============================================================================

# Supabase Database (REQUIRED)
# Get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase CLI (for migrations and remote management)
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_ACCESS_TOKEN=your-access-token

# Multi-Tenancy (REQUIRED)
# Organization slug for default tenant (must match database organizations.slug)
NEXT_PUBLIC_ORG_SLUG=watershed-campground

# Admin Access (REQUIRED)
# Comma-separated list of admin email addresses
ADMIN_EMAILS=admin@test.com

# ============================================================================
# OPTIONAL - Payment Processing
# ============================================================================

# Stripe (Optional in dev, required for payment flow)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ============================================================================
# OPTIONAL - External Services
# ============================================================================

# Resend Email Service (Optional - for confirmation emails)
RESEND_API_KEY=re_...

# Upstash Redis (Optional - for rate limiting)
# Get these from console.upstash.com after creating a Redis database
# See docs/RATE_LIMITING.md for setup instructions
UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=Axxxxx...

# Google Analytics (Optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ============================================================================
# OPTIONAL - Deployment Configuration
# ============================================================================

# Base URL (Optional - for absolute URLs in emails, OG tags)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Vercel Environment (Automatically set by Vercel)
# VERCEL_ENV=development|preview|production

# ============================================================================
# OPTIONAL - Advanced Settings
# ============================================================================

# Stuck saving failsafe timeout in milliseconds (default: 10000)
# Minimum: 100ms to prevent instant triggers
NEXT_PUBLIC_STUCK_SAVING_TIMEOUT_MS=10000

# ============================================================================
# TEST-SPECIFIC CONFIGURATION (for .env.test only)
# ============================================================================

# Test Admin Credentials (matches supabase/seed.sql)
TEST_ADMIN_EMAIL=admin@test.com
TEST_ADMIN_PASSWORD=testpass123

# E2E Test Configuration
E2E_DB_RESET_ENABLED=true
E2E_ORG_SLUG=watershed-campground

# Stripe Test Mode (Optional - enables payment tests in CI)
STRIPE_TESTS_ENABLED=false

# ============================================================================
# DEVELOPMENT TIPS
# ============================================================================

# After adding NEXT_PUBLIC_* variables, restart your dev server:
#   npm run dev
#
# Validate your environment configuration:
#   npm run env:check
#
# See docs/testing.md for testing environment setup
